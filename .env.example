# Supabase 项目 URL，例如 https://xxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase API Key（anon 或 service_role，见项目 Settings -> API）
SUPABASE_KEY=your-anon-or-service-role-key

# 靶子模型（OpenAI 兼容端点）
TARGET_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TARGET_API_KEY=your-target-model-key
TARGET_MODEL=glm-4-flash

# 判定器：regex=仅规则，llm=仅裁判模型，both=双裁判（默认）
JUDGE_MODE=both
# 裁判模型（默认 glm-4-flash，复用 TARGET_BASE_URL/TARGET_API_KEY）
JUDGE_MODEL=glm-4-flash
