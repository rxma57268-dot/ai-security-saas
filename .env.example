# Supabase 项目 URL，例如 https://xxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase API Key（anon key；RLS 按用户隔离，禁止用 service_role）
SUPABASE_KEY=your-anon-key

# 靶子模型（OpenAI 兼容端点，切换厂商只改这三行）
TARGET_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TARGET_API_KEY=your-target-model-key
TARGET_MODEL=glm-4-flash

# 判定器：regex=仅规则，llm=仅裁判模型，both=双裁判（默认），
# funnel=三级漏斗 regex → Prompt Guard → LLM（Sprint 3，需 pip install transformers torch）
JUDGE_MODE=both
# 裁判模型（默认 glm-4-flash，复用 TARGET_BASE_URL/TARGET_API_KEY）
JUDGE_MODEL=glm-4-flash
# 裁判独立端点（可选，v3：跨厂商裁判避免"自己人判自己人"）
# JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# JUDGE_API_KEY=your-judge-key

# Agent/attacker 模型（缺省回落 JUDGE_MODEL → TARGET_MODEL）
# AGENT_MODEL=glm-4-flash

# Embedding（策略库语义检索，默认智谱 embedding-3；可用 EMBEDDING_* 换厂商）
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=your-key
# EMBEDDING_MODEL=embedding-3

# 多轮探测轮次上限（默认 8）
# MAX_ROUNDS=8

# 探测模式：template=模板渲染（默认），pair=PAIR 文献基线，
# dynamic=动态红队（Attacker Function Call 工具组合 + 策略库检索增强，v3 Sprint 4A/4C）
# PROBE_MODE=template
